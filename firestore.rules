rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isOwnedByUserDoc(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    function isValidAirportIcao(icao) {
      return icao in [
        'EGLL', 'OIII', 'KJFK', 'OIIE', 'OISS', 'OMDB', 'LFPG', 'EHAM',
        'EDDF', 'LSZH', 'EGJJ', 'KORD', 'KSFO', 'RJTT', 'TRN1', 'TRN2'
      ];
    }

    // Entity Blueprint: UserProfile (/users/{userId})
    function isValidUserProfile(data) {
      let allMissions = ['mission_1', 'mission_2', 'mission_3', 'mission_4', 'mission_5'];
      return data.keys().hasAll([
          'uid',
          'callsign',
          'authProvider',
          'certified',
          'completedMissions',
          'totalLandings',
          'totalDepartures',
          'totalGoArounds',
          'totalViolations',
          'totalFlightSeconds',
          'sessionsCompleted',
          'bestScore',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'callsign',
          'authProvider',
          'certified',
          'certificateId',
          'issuedAt',
          'completedMissions',
          'totalLandings',
          'totalDepartures',
          'totalGoArounds',
          'totalViolations',
          'totalFlightSeconds',
          'sessionsCompleted',
          'bestScore',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.callsign is string
        && data.callsign.size() >= 2
        && data.callsign.size() <= 32
        && data.authProvider in ['password', 'google']
        && data.certified is bool
        && data.completedMissions is list
        && data.completedMissions.size() <= 5
        && data.completedMissions.hasOnly(allMissions)
        && (
          !data.certified || (
            data.completedMissions.hasAll(allMissions)
            && ('certificateId' in data)
            && data.certificateId is string
            && data.certificateId.size() >= 6
            && data.certificateId.size() <= 64
            && ('issuedAt' in data)
            && data.issuedAt is string
            && data.issuedAt.size() >= 10
            && data.issuedAt.size() <= 64
          )
        )
        && (
          !('certificateId' in data) || (
            data.certificateId is string
            && data.certificateId.size() >= 6
            && data.certificateId.size() <= 64
          )
        )
        && (
          !('issuedAt' in data) || (
            data.issuedAt is string
            && data.issuedAt.size() >= 10
            && data.issuedAt.size() <= 64
          )
        )
        && data.totalLandings is int
        && data.totalLandings >= 0
        && data.totalLandings <= 100000
        && data.totalDepartures is int
        && data.totalDepartures >= 0
        && data.totalDepartures <= 100000
        && data.totalGoArounds is int
        && data.totalGoArounds >= 0
        && data.totalGoArounds <= 100000
        && data.totalViolations is int
        && data.totalViolations >= 0
        && data.totalViolations <= 100000
        && data.totalFlightSeconds is int
        && data.totalFlightSeconds >= 0
        && data.totalFlightSeconds <= 10000000
        && data.sessionsCompleted is int
        && data.sessionsCompleted >= 0
        && data.sessionsCompleted <= 100000
        && data.bestScore is number
        && data.bestScore >= 0
        && data.bestScore <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && (!('authProvider' in existing()) || incoming().authProvider == existing().authProvider)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['callsign', 'updatedAt'])
          || (
            !('authProvider' in existing())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'authProvider',
              'totalGoArounds',
              'totalViolations',
              'totalFlightSeconds',
              'sessionsCompleted',
              'updatedAt'
            ])
          )
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'completedMissions',
            'certified',
            'certificateId',
            'issuedAt',
            'totalLandings',
            'totalDepartures',
            'totalGoArounds',
            'totalViolations',
            'totalFlightSeconds',
            'sessionsCompleted',
            'bestScore',
            'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'totalLandings',
            'totalDepartures',
            'totalGoArounds',
            'totalViolations',
            'totalFlightSeconds',
            'sessionsCompleted',
            'bestScore',
            'updatedAt'
          ])
        );
      allow delete: if false;
    }

    // Entity Blueprint: UserPreferences (/users/{userId}/settings/preferences)
    function isValidRadarLayers(layers) {
      return layers is map
        && layers.keys().hasAll([
          'terrain',
          'rangeRings',
          'runways',
          'holdingStacks',
          'waypointLabels',
          'extendedCenterlines',
          'trails',
          'speedVectors',
          'radarSweep',
          'starCorridors',
          'sidCorridors',
          'procedureRestrictions',
          'tmaBoundary',
          'extendedTargetTags'
        ])
        && layers.keys().hasOnly([
          'terrain',
          'rangeRings',
          'runways',
          'holdingStacks',
          'waypointLabels',
          'extendedCenterlines',
          'trails',
          'speedVectors',
          'radarSweep',
          'starCorridors',
          'sidCorridors',
          'procedureRestrictions',
          'tmaBoundary',
          'extendedTargetTags'
        ])
        && layers.terrain is bool
        && layers.rangeRings is bool
        && layers.runways is bool
        && layers.holdingStacks is bool
        && layers.waypointLabels is bool
        && layers.extendedCenterlines is bool
        && layers.trails is bool
        && layers.speedVectors is bool
        && layers.radarSweep is bool
        && layers.starCorridors is bool
        && layers.sidCorridors is bool
        && layers.procedureRestrictions is bool
        && layers.tmaBoundary is bool
        && layers.extendedTargetTags is bool;
    }

    function isValidRadarTheme(themeId) {
      return themeId in [
        'phosphor_crt',
        'amber_atc',
        'obsidian_blue',
        'tactical_stealth',
        'crimson_tactical',
        'daylight_paper'
      ];
    }

    function isValidUserPreferences(data) {
      return data.keys().hasAll([
          'uid',
          'preferredAirportIcao',
          'preferredLandingRunwayId',
          'preferredDepartureRunwayId',
          'simSpeed',
          'audioMuted',
          'audioVolume',
          'towerVoiceId',
          'radioPreset',
          'radarLayers',
          'perAirportVisibility',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'preferredAirportIcao',
          'preferredLandingRunwayId',
          'preferredDepartureRunwayId',
          'simSpeed',
          'audioMuted',
          'audioVolume',
          'towerVoiceId',
          'radioPreset',
          'radarTheme',
          'radarLayers',
          'perAirportVisibility',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidAirportIcao(data.preferredAirportIcao)
        && data.preferredLandingRunwayId is string
        && data.preferredLandingRunwayId.size() >= 2
        && data.preferredLandingRunwayId.size() <= 4
        && data.preferredDepartureRunwayId is string
        && data.preferredDepartureRunwayId.size() >= 2
        && data.preferredDepartureRunwayId.size() <= 4
        && data.simSpeed is int
        && data.simSpeed >= 1
        && data.simSpeed <= 5
        && data.audioMuted is bool
        && data.audioVolume is number
        && data.audioVolume >= 0
        && data.audioVolume <= 1
        && data.towerVoiceId is string
        && data.towerVoiceId.size() >= 2
        && data.towerVoiceId.size() <= 64
        && data.radioPreset in [
          'clear_communication',
          'normal_aviation',
          'weak_signal',
          'heavy_interference',
          'emergency_transmission'
        ]
        && (!('radarTheme' in data) || isValidRadarTheme(data.radarTheme))
        && isValidRadarLayers(data.radarLayers)
        && data.perAirportVisibility is map
        && data.perAirportVisibility.size() <= 16
        && data.perAirportVisibility.keys().hasOnly([
          'EGLL', 'OIII', 'KJFK', 'OIIE', 'OISS', 'OMDB', 'LFPG', 'EHAM',
          'EDDF', 'LSZH', 'EGJJ', 'KORD', 'KSFO', 'RJTT', 'TRN1', 'TRN2'
        ])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/settings/{settingId} {
      allow get: if isValidId(userId) && settingId == 'preferences' && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && settingId == 'preferences'
        && isOwner(userId)
        && isOwnedByUserDoc(userId)
        && isValidUserPreferences(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && settingId == 'preferences'
        && isOwner(userId)
        && isOwnedByUserDoc(userId)
        && isValidUserPreferences(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'preferredAirportIcao',
          'preferredLandingRunwayId',
          'preferredDepartureRunwayId',
          'simSpeed',
          'audioMuted',
          'audioVolume',
          'towerVoiceId',
          'radioPreset',
          'radarTheme',
          'radarLayers',
          'perAirportVisibility',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Entity Blueprint: ActivityEntry (/users/{userId}/activities/{activityId})
    function isValidActivityEntry(data) {
      let allMissions = ['mission_1', 'mission_2', 'mission_3', 'mission_4', 'mission_5'];
      return data.keys().hasAll([
          'id',
          'uid',
          'kind',
          'title',
          'airportIcao',
          'landingRunwayId',
          'departureRunwayId',
          'landings',
          'departures',
          'goArounds',
          'violations',
          'score',
          'durationSeconds',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'uid',
          'kind',
          'title',
          'missionId',
          'airportIcao',
          'landingRunwayId',
          'departureRunwayId',
          'landings',
          'departures',
          'goArounds',
          'violations',
          'score',
          'durationSeconds',
          'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.kind in ['mission_pass', 'mission_fail', 'free_ops', 'custom_ops']
        && data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 100
        && (!('missionId' in data) || data.missionId in allMissions)
        && isValidAirportIcao(data.airportIcao)
        && data.landingRunwayId is string
        && data.landingRunwayId.size() >= 2
        && data.landingRunwayId.size() <= 4
        && data.departureRunwayId is string
        && data.departureRunwayId.size() >= 2
        && data.departureRunwayId.size() <= 4
        && data.landings is int
        && data.landings >= 0
        && data.landings <= 1000
        && data.departures is int
        && data.departures >= 0
        && data.departures <= 1000
        && data.goArounds is int
        && data.goArounds >= 0
        && data.goArounds <= 1000
        && data.violations is int
        && data.violations >= 0
        && data.violations <= 1000
        && data.score is number
        && data.score >= 0
        && data.score <= 100
        && data.durationSeconds is int
        && data.durationSeconds >= 0
        && data.durationSeconds <= 86400
        && data.createdAt is timestamp;
    }

    match /users/{userId}/activities/{activityId} {
      allow get: if isValidId(userId) && isValidId(activityId) && isOwner(userId);
      allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId)
        && isValidId(activityId)
        && isOwner(userId)
        && isOwnedByUserDoc(userId)
        && isValidActivityEntry(incoming())
        && incoming().id == activityId
        && incoming().uid == userId
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId)
        && isValidId(activityId)
        && isOwner(userId)
        && existing().uid == request.auth.uid;
    }

    // Entity Blueprint: CustomScenario (/scenarios/{scenarioId})
    function isValidScenario(data) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'name',
          'description',
          'difficulty',
          'airportIcao',
          'landingRunwayId',
          'departureRunwayId',
          'windDirection',
          'windSpeed',
          'gusts',
          'qnh',
          'visibilityNM',
          'ceilingFeet',
          'precipitation',
          'initialInbounds',
          'initialDepartures',
          'spawnIntervalSec',
          'heavyRatio',
          'allowEmergencies',
          'emergencyDelaySec',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerId',
          'name',
          'description',
          'difficulty',
          'airportIcao',
          'landingRunwayId',
          'departureRunwayId',
          'windDirection',
          'windSpeed',
          'gusts',
          'qnh',
          'visibilityNM',
          'ceilingFeet',
          'precipitation',
          'initialInbounds',
          'initialDepartures',
          'spawnIntervalSec',
          'heavyRatio',
          'allowEmergencies',
          'emergencyDelaySec',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 80
        && data.description is string
        && data.description.size() <= 300
        && data.difficulty in ['Beginner', 'Intermediate', 'Advanced', 'Master']
        && isValidAirportIcao(data.airportIcao)
        && data.landingRunwayId is string
        && data.landingRunwayId.size() >= 2
        && data.landingRunwayId.size() <= 4
        && data.departureRunwayId is string
        && data.departureRunwayId.size() >= 2
        && data.departureRunwayId.size() <= 4
        && data.windDirection is number
        && data.windDirection >= 0
        && data.windDirection <= 359
        && data.windSpeed is number
        && data.windSpeed >= 0
        && data.windSpeed <= 60
        && data.gusts is number
        && data.gusts >= 0
        && data.gusts <= 80
        && data.qnh is number
        && data.qnh >= 940
        && data.qnh <= 1050
        && data.visibilityNM is number
        && data.visibilityNM >= 0.5
        && data.visibilityNM <= 20
        && data.ceilingFeet is number
        && data.ceilingFeet >= 100
        && data.ceilingFeet <= 20000
        && data.precipitation in ['None', 'Light Rain', 'Rain', 'Fog']
        && data.initialInbounds is int
        && data.initialInbounds >= 0
        && data.initialInbounds <= 12
        && data.initialDepartures is int
        && data.initialDepartures >= 0
        && data.initialDepartures <= 6
        && data.spawnIntervalSec is int
        && data.spawnIntervalSec >= 10
        && data.spawnIntervalSec <= 180
        && data.heavyRatio is number
        && data.heavyRatio >= 0
        && data.heavyRatio <= 1
        && data.allowEmergencies is bool
        && data.emergencyDelaySec is int
        && data.emergencyDelaySec >= 5
        && data.emergencyDelaySec <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /scenarios/{scenarioId} {
      allow get: if isValidId(scenarioId)
        && isSignedIn()
        && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(scenarioId)
        && isSignedIn()
        && isValidScenario(incoming())
        && incoming().id == scenarioId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(scenarioId)
        && isSignedIn()
        && existing().ownerId == request.auth.uid
        && isValidScenario(incoming())
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'description',
          'difficulty',
          'airportIcao',
          'landingRunwayId',
          'departureRunwayId',
          'windDirection',
          'windSpeed',
          'gusts',
          'qnh',
          'visibilityNM',
          'ceilingFeet',
          'precipitation',
          'initialInbounds',
          'initialDepartures',
          'spawnIntervalSec',
          'heavyRatio',
          'allowEmergencies',
          'emergencyDelaySec',
          'updatedAt'
        ]);
      allow delete: if isValidId(scenarioId)
        && isSignedIn()
        && existing().ownerId == request.auth.uid;
    }
  }
}
